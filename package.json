{
  "name": "vane",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p .",
    "test": "claude plugin test .",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1"
  },
  "description": "Claude Code mod (plugin) that adds a side pane with Overview, Agents, Context, Setup and Spend tabs, a status line above the prompt, a restyled chat, Mermaid diagrams in the terminal, tables, and code and diff panels. Colours follow both /color and the /theme (dark, light and others).",
  "keywords": [
    "claude-code",
    "claude-code-mod",
    "claude-code-plugin",
    "claude-mod",
    "function-hooks",
    "side-pane",
    "sidebar",
    "statusline",
    "status-line",
    "subagents",
    "subagent-tree",
    "agent-monitor",
    "mcp",
    "context-window",
    "token-usage",
    "mermaid",
    "tables",
    "diff",
    "tui",
    "terminal-ui",
    "theme",
    "ui",
    "anthropic"
  ],
  "license": "MIT",
  "author": "Guilherme Wohl",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guiwohl/vane.git"
  }
}
